# =============================================================================
# .dockerignore — Minimiza el contexto de build para evitar el bug de tar
# stream en macOS con el builder legacy (DOCKER_BUILDKIT=0).
# Contexto ideal: solo pyproject.toml, README.md, b2b_ai/ y landing/.
# =============================================================================

# --- Entornos / caches locales ---
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Bases de datos y temporales ---
*.db
*.db-shm
*.db-wal
b2b_ai.db
.coverage
.DS_Store

# --- Entorno / secrets ---
.env
.env.*
!.env.example

# --- Git y CI ---
.git/
.gitignore
.railway/

# --- Documentación y reportes (no necesarios en el contenedor) ---
docs/
reports/
*.md
!README.md

# --- Tests y scripts de desarrollo ---
tests/
scripts/
fixtures/
demo-data/
demo-output/
demo_server.py
demo_launch.sh
demo_run.sh
fix_integrations.py
add_env_vars.py

# --- Landing alternativa (no la principal) ---
landing-b/

# --- Código fuente auxiliar no necesario para pip install ---
_src/

# --- Hermes / IDE / cache ---
.hermes/
.cache/
node_modules/

# --- Logs y archivos grandes ---
*.log
*.tar.gz
*.mp4
*.png
*.jpg
*.jpeg

# --- Configuración de deploy (no necesarios en el contenedor) ---
railway.toml
Dockerfile
docker-compose*.yml
.dockerignore
Makefile
deploy-*.sh
start.sh
stop.sh
test.sh
runtime.txt
requirements-*.txt
alembic.ini
Procfile

# --- Reportes y QA ---
QA_REPORT*.md
FIX_REPORT.md
MODULE_REPORT.md
PG_BUG_REPORT.md
DEPLOY*.md
README-DEMO.md
README-DEPLOY.md
