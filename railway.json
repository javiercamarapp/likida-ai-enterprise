{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install --upgrade pip && pip install -e . uvicorn[standard]"
  },
  "deploy": {
    "startCommand": "uvicorn b2b_ai.api.app:app --host 0.0.0.0 --port $PORT --workers ${B2B_WORKERS:-1} --proxy-headers",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}