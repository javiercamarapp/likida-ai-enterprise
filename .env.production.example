# =============================================================================
# .env.production.example — Likida AI: complete production environment config
# =============================================================================
# Copy this file to .env.production and adjust ALL values before deploying.
#
#   cp .env.production.example .env.production
#   vi .env.production
#   chmod 600 .env.production
#
# For Railway CLI:
#   railway variables set B2B_API_KEY="$(openssl rand -hex 32)" --environment production
#
# Generate secrets with:
#   openssl rand -hex 32    → API keys, JWT secrets
#   openssl rand -hex 24    → Encryption keys
#   openssl rand -base64 32 → Alternative format
# =============================================================================

# --- SECURITY / AUTH --------------------------------------------------------
# API key master (service-level auth). MANDATORY in production.
# Generate with: openssl rand -hex 32
# Used in header: X-API-Key
B2B_API_KEY=change-me-please

# JWT signing secret for portal auth + enterprise RBAC.
# MANDATORY: app will NOT start without this (min 32 chars).
# Generate with: openssl rand -hex 32
B2B_JWT_SECRET=change-me-please-32-chars-minimum

# AES-GCM encryption key for sensitive fields at rest (webhook URLs, notification recipients).
# MANDATORY in production. Generate with: openssl rand -hex 24
B2B_ENCRYPTION_KEY=change-me-please

# --- ENVIRONMENT ------------------------------------------------------------
# Must be "production" to enable startup validations and security hardening
B2B_ENVIRONMENT=production
B2B_DEBUG=false

# --- BASE DATA (auto-configured by Railway) ---------------------------------
# Railway assigns DATABASE_URL automatically when you add the PostgreSQL add-on.
# The app reads this internally as B2B_DB_URL. DO NOT set manually.
# DATABASE_URL=postgresql://user:***@host:5432/likida_ai

# PostgreSQL connection pool (optional, sane defaults)
B2B_PG_POOL_MIN=2
B2B_PG_POOL_MAX=10
B2B_PG_RETRIES=3

# Railway assigns REDIS_URL automatically when you add the Redis add-on.
# REDIS_URL=redis://:password@host:6379/0

# --- REDIS (for caching and rate limiting) -----------------------------------
# Railway auto-configures this via Redis add-on. Do not set manually.
# REDIS_URL=redis://:password@host:6379/0

# --- SERVER / WORKERS -------------------------------------------------------
# Railway Pro: 0.5-1 CPU, 512MB-1GB RAM. 1 worker is safe; scale up with PostgreSQL.
B2B_WORKERS=1

# --- PORT (auto-configured by Railway) --------------------------------------
# Railway assigns PORT dynamically. The Dockerfile CMD uses ${PORT:-${B2B_PORT}}.
# You do NOT need to set this. Defaults to 8000 for local Docker.
B2B_PORT=8000

# --- CORS (allowed origins for cross-domain API calls) ----------------------
# Comma-separated. Empty = CORS disabled (same-origin only).
# Set this if your landing/frontend is on a different domain than the API.
B2B_CORS_ORIGINS=https://likida.mx,https://www.likida.mx,https://app.likida.mx
B2B_CORS_ALLOW_CREDENTIALS=true

# --- RATE LIMITING -----------------------------------------------------------
B2B_RATE_LIMIT=on
B2B_RATE_LIMIT_PER_MIN=300

# --- TRANSPORT SECURITY (HSTS / CSP) ----------------------------------------
B2B_HSTS=true
B2B_HSTS_ALWAYS=true
B2B_TRUST_PROXY=true

# --- PAYMENTS: STRIPE (international) ----------------------------------------
# Secret key for server-side operations (charges, subscriptions)
B2B_STRIPE_SECRET=sk_live_change_me

# Publishable key (client-side checkout, if used)
B2B_STRIPE_PUBLISHABLE_KEY=pk_live_change_me

# Webhook signature verification secret (for /api/v1/webhooks/stripe)
B2B_STRIPE_WEBHOOK_SECRET=whsec_change_me

# --- PAYMENTS: CONEKTA (México) ---------------------------------------------
# Note: CONEKTA, not CONEXTA. Key format: key_...
B2B_CONEKTA_KEY=key_change_me

# Conekta public key (for client-side, if used)
B2B_CONEKTA_PUBLIC_KEY=pk_change_me

# --- NOTIFICATIONS: SMTP / EMAIL ---------------------------------------------
# Without credentials, notifications are logged as "simulated" (safe mode).
B2B_SMTP_HOST=smtp.gmail.com
B2B_SMTP_PORT=587
B2B_SMTP_USER=notifications@likida.mx
B2B_SMTP_PASS=your-app-password-here
B2B_SMTP_FROM="Likida AI <notifications@likida.mx>"
B2B_SMTP_USE_SSL=true

# --- WHATSAPP BUSINESS API --------------------------------------------------
B2B_WHATSAPP_TOKEN=your-whatsapp-business-token
B2B_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# --- LLM (optional; pipeline runs 100% with rules, no LLM needed) -----------
# Values: openai | deepseek | anthropic | openrouter | "" (empty = rules only)
B2B_LLM_PROVIDER=openai
B2B_LLM_MODEL=gpt-4o-mini
# Uncomment the key for your chosen provider:
#B2B_OPENAI_API_KEY=sk-...
#B2B_ANTHROPIC_API_KEY=sk-ant-...
#B2B_OPENROUTER_API_KEY=sk-or-...
#B2B_DEEPSEEK_API_KEY=...

# --- DEMO MODE (no real backend) --------------------------------------------
# false for production. true = mock data on /api/demo/* (for prospects only).
B2B_DEMO_MODE=false

# --- APP URLS ----------------------------------------------------------------
B2B_APP_NAME=Likida AI
B2B_APP_URL=https://api.likida.mx
B2B_LANDING_URL=https://likida.mx
B2B_PORTAL_URL=https://app.likida.mx

# --- DATA RETENTION ----------------------------------------------------------
# Days to keep operational data (audit_log, webhook_deliveries, notifications).
# Invoices (tax data) are NOT purged — SAT mandates their retention.
B2B_RETENTION_DAYS=365

# --- MONITORING / ALERTS -----------------------------------------------------
# B2B_ALERT_WEBHOOK_URL=https://hooks.example.com/likida-alerts
B2B_LOG_LEVEL=INFO

# --- DOMAIN / ROUTING (informational — set in Railway dashboard) ------------
# After deploy, assign your custom domain in Railway:
#   railway domain api.likida.mx
# Then point DNS (Cloudflare):
#   CNAME  api.likida.mx  → <railway-domain>.up.railway.app
