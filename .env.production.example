# =============================================================================
# B&B AI — .env.production.example
# Configuración de producción. Copia a `.env.production` y ajusta TODOS los
# valores. Ningún secreto en este archivo es válido para producción.
#
#   cp .env.production.example .env.production && vi .env.production
#   chmod 600 .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# =============================================================================

# --- Seguridad / Auth --------------------------------------------------------
# API key maestra de servicio. OBLIGATORIA y secreta.
# Genera una con:  openssl rand -hex 32
B2B_API_KEY=change-me-please

# Secret de firma de JWT (auth enterprise /api/v1/auth/*, RBAC por tenant).
# OBLIGATORIO en producción: sin él se usa un secret de desarrollo que
# cualquiera puede adivinar.  Genera con:  openssl rand -hex 32
#B2B_JWT_SECRET=change-me-please

# Rate-limit por IP+ruta (peticiones por minuto). 0 desactiva; "off" la apaga.
B2B_RATE_LIMIT=on
B2B_RATE_LIMIT_PER_MIN=300

# Proxy de confianza para X-Forwarded-For. Solo si usas un reverse proxy
# (nginx, Cloudflare, etc.) QUE YA FILTRA headers XFF falsos. IPs separadas
# por coma, ej: "10.0.0.1,10.0.0.2". Sin esta variable, el rate limiter usa
# la IP real de la conexión (RECOMENDADO para producción sin proxy).
# B2B_TRUST_PROXY=

# --- CORS (orígenes permitidos para llamar a la API desde otro dominio) -------
# Coma-separados. Vacío = CORS desactivado (solo same-origin, la landing se
# sirve desde el mismo origen). "*" permite cualquier origen (NO uses con
# credenciales). La API autentica con header X-API-Key, no cookies:
#   B2B_CORS_ALLOW_CREDENTIALS=false
B2B_CORS_ORIGINS=
B2B_CORS_ALLOW_CREDENTIALS=false

# --- Servidor / workers ------------------------------------------------------
# Workers de uvicorn. Con SQLite (estado actual) usa SIEMPRE 1 (escritura
# serializada). Cuando exista el adaptador Postgres puedes subir a N:
#   B2B_WORKERS=$(nproc)
B2B_WORKERS=1

# --- Base de datos -----------------------------------------------------------
# Estado actual: SQLite persistido en volumen (lo fija docker-compose.prod.yml).
# Con PostgreSQL (producción) activa el adaptador PG + pool; Alembic
# (migrations/) lleva el esquema a head en cada arranque.
# Roadmap (adaptador Postgres) — entonces descomenta y apunta al servicio:
# B2B_DB_URL=postgresql://${POSTGRES_USER}:***@postgres:5432/${POSTGRES_DB}
# Tamaños del pool de conexiones PG (opcional, defaults sanos):
# B2B_PG_POOL_MIN=2
# B2B_PG_POOL_MAX=10
# B2B_PG_RETRIES=3
POSTGRES_DB=b2b_ai
POSTGRES_USER=b2b
# OBLIGATORIO, secreto.  Genera con:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-please

# --- Redis (provisionado; integración en roadmap) ----------------------------
# URL interna del servicio Redis del stack. No expuesto al host.
REDIS_URL=redis://redis:6379/0

# --- LLM (opcional; el pipeline corre 100% con reglas sin LLM) ---------------
# Valores: openai | deepseek | anthropic | "" (vacío = sin LLM, solo reglas).
B2B_LLM_PROVIDER=
#B2B_LLM_MODEL=gpt-4o-mini
#B2B_OPENAI_API_KEY=
#B2B_DEEPSEEK_API_KEY=
#B2B_ANTHROPIC_API_KEY=

# --- Notificaciones (email / SMTP) -------------------------------------------
# Sin credenciales el sistema NO envía nada real (registra como simulado).
#SMTP_HOST=smtp.tu-proveedor.com
#SMTP_PORT=465
#SMTP_USER=agente@tu-dominio.com
#SMTP_PASSWORD=********
#SMTP_FROM=agente@tu-dominio.com
#SMTP_USE_SSL=true

# --- Entorno -----------------------------------------------------------------
DEBUG=false
ENV=production

# --- Seguridad de datos (cifrado en reposo + retención) -----------------------
# Clave de cifrado AES-GCM para campos sensibles (webhook_url, notif_recipient).
# OBLIGATORIA en producción. Genera con:  openssl rand -hex 24
B2B_ENCRYPTION_KEY=

# Retención de datos operativos (días): audit_log, webhook_deliveries,
# notifications y portal_sessions se purgan pasado este umbral. Las facturas
# (datos fiscales) NO se tocan: su retención la manda el SAT.
B2B_RETENTION_DAYS=365

# --- Seguridad de transporte (HSTS / CSP) -------------------------------------
# Forzar HSTS siempre (aun en HTTP local). Útil detrás de un proxy que termina
# TLS:  B2B_HSTS=true  +  B2B_TRUST_PROXY=true  (confía en X-Forwarded-Proto).
B2B_HSTS=true
B2B_HSTS_ALWAYS=false
# Confía en X-Forwarded-Proto del proxy para decidir HTTPS (HSTS).
B2B_TRUST_PROXY=false
# CSP override (opcional). Vacío = CSP por defecto de la app.
#B2B_CSP=default-src 'self';

# --- Alertas / monitoreo ------------------------------------------------------
# Webhook de salida para alertas de monitoreo (solo esquema http/https).
#B2B_ALERT_WEBHOOK_URL=https://hooks.example.com/b2b-alerts

# --- Logging ------------------------------------------------------------------
# Niveles: DEBUG | INFO | WARNING | ERROR | CRITICAL
B2B_LOG_LEVEL=INFO
