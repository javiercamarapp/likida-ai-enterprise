# =============================================================================
# .env.production.example — Entorno de producción para Docker Compose / VPS
# Uso:  cp .env.example .env.production && vi .env.production
#       docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# =============================================================================
B2B_ENV=production

POSTGRES_DB=b2b_ai
POSTGRES_USER=b2b
POSTGRES_PASSWORD=cambia-este-password

# --- Secretos (openssl rand -hex 32) ---
B2B_JWT_SECRET=
B2B_API_KEY=
B2B_ENCRYPTION_KEY=

B2B_WORKERS=2
B2B_TRUST_PROXY=true
B2B_RATE_LIMIT=on
B2B_RATE_LIMIT_PER_MIN=300
