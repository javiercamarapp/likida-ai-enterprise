# =============================================================================
# B&B AI — Agente Contable enterprise · Configuración por variables de entorno
# =============================================================================
# Copia este archivo a `.env` y ajusta los valores antes de arrancar:
#   cp .env.example .env  &&  vi .env
# El servicio Docker (docker-compose) lee este `.env` automáticamente.
# =============================================================================

# --- Seguridad / Auth --------------------------------------------------------
# API key maestra de servicio. En dev cualquier valor sirve; en producción usa
# una larga y aleatoria:  openssl rand -hex 32
# Los endpoints /api/v1/* la exigen en el header `X-API-Key`.
# En multi-tenant real, además se pueden aprovisionar keys por despacho en la
# tabla `api_keys` de la DB.
B2B_API_KEY=change-me

# --- Base de datos -----------------------------------------------------------
# Ruta del archivo SQLite (SQLite para dev/single-node; la app es PG-ready).
# En Docker se fuerza /data/b2b_ai.db montado en un volumen nombrado.
B2B_DB_PATH=./b2b_ai.db

# --- Landing page (estática) -------------------------------------------------
# Ruta a la carpeta de la landing (index.html, robots.txt, sitemap.xml).
# Se auto-detecta: en el repo es <raíz>/landing, en Docker /app/landing.
# Solo se sobreescribe si la landing vive en otra ruta.
#B2B_LANDING_DIR=/ruta/a/landing

# --- LLM (opcional; el pipeline corre 100% con reglas sin LLM) ---------------
# Proveedor del LLM para clasificación asistida / razonamiento avanzado.
# Valores: openai | deepseek | anthropic | openrouter | "" (vacío = sin LLM, solo reglas).
B2B_LLM_PROVIDER=
# Modelo por defecto (según proveedor):
#   openai   → gpt-4o-mini
#   deepseek → deepseek-chat
#   anthropic→ claude-sonnet-4-20250514
#   openrouter→ deepseek/deepseek-v4-flash
#B2B_LLM_MODEL=gpt-4o-mini
# Base URL del LLM (opcional, para gateways/proxies tipo OpenAI-compatible).
# OpenRouter por defecto: https://openrouter.ai/api/v1
#B2B_LLM_BASE_URL=
# Claves de API del proveedor que uses (solo la del proveedor elegido).
#B2B_OPENAI_API_KEY=
#B2B_DEEPSEEK_API_KEY=
#B2B_ANTHROPIC_API_KEY=
#B2B_OPENROUTER_API_KEY=

# --- Notificaciones (email / SMTP) -------------------------------------------
# Opcional. Sin credenciales el sistema NO envía nada real: registra el mensaje
# como "simulado" (modo seguro). Configúralas para envío real por SMTP.
# El servidor se instancia con estos parámetros (ver b2b_ai/notifications/sender.py).
#SMTP_HOST=smtp.tu-proveedor.com
#SMTP_PORT=465
#SMTP_USER=agente@tu-dominio.com
#SMTP_PASSWORD=********
#SMTP_FROM=agente@tu-dominio.com
#SMTP_USE_SSL=true

# --- Aplicación web / servidor ----------------------------------------------
# Puerto y host del servidor uvicorn (usado por start.sh local).
B2B_HOST=0.0.0.0
B2B_PORT=8000

# --- Entorno -----------------------------------------------------------------
# DEBUG=true → logs más verbosos. PROD=false → restricciones de seguridad.
#DEBUG=false
#ENV=production

# --- Cobros / Billing (Stripe + Conekta) -------------------------------------
# Proveedor de pagos. Stripe es el default; para México usar Conekta.
#   B2B_PAYMENTS_PROVIDER=stripe | conekta
#B2B_PAYMENTS_PROVIDER=stripe
# Claves secretas de los proveedores (NUNCA commitear valores reales).
#B2B_STRIPE_KEY=sk_test_...
#B2B_CONEXTA_KEY=key_...
# Modo mock (sin red, resultados deterministas): util para demo/tests.
# B2B_PAYMENTS_MOCK=1
#B2B_PAYMENTS_MOCK=0
