# =============================================================================
# B2B AI — Agente Contable enterprise · Required Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values before starting:
#   cp .env.example .env && vi .env
# =============================================================================

# --- AI Providers -----------------------------------------------------------
# OpenAI (for GPT-4, embeddings, classification)
OPENAI_API_KEY=

# Anthropic (for Claude)
ANTHROPIC_API_KEY=

# OpenRouter (alternative gateway)
#OPENROUTER_API_KEY=

# --- Communication ----------------------------------------------------------
# SendGrid (transactional email: invoices, reports, notifications)
SENDGRID_API_KEY=

# Twilio (SMS + WhatsApp for client notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+52XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+1XXXXXXXXXX

# --- Payments ---------------------------------------------------------------
# Stripe (card payments, subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Conekta (Mexico local payments — SPEI, OXXO)
#CONEKTA_KEY=

# --- Storage ----------------------------------------------------------------
# Google Drive (shared client folders, backup)
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=root

# AWS S3 (CFDI archive, backups)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# --- Monitoring -------------------------------------------------------------
# Sentry (error tracking, performance monitoring)
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0

# --- ERP (Computer Use) -----------------------------------------------------
# CONTPAQi Web (browser automation)
CONTPAQI_URL=https://contpaqiweb.example.com/app
CONTPAQI_USERNAME=
CONTPAQI_PASSWORD=

# Aspel Cloud (browser automation)
ASPEL_URL=https://aspelcloud.example.com/app
ASPEL_USERNAME=
ASPEL_PASSWORD=

# --- SAT / CFDI -------------------------------------------------------------
# Digital certificates for electronic invoicing (FIEL/CSD)
SAT_FIEL_CERT=
SAT_FIEL_KEY=
SAT_CSD_CERT=
SAT_CSD_KEY=

# --- PAC (Timbrado) ---------------------------------------------------------
# Ecodex
ECODEX_USER=
ECODEX_PASSWORD=
ECODEX_URL=https://ecodex.example.com

# Finkok
FINKOK_USER=
FINKOK_PASSWORD=
FINKOK_URL=https://finkok.example.com

# --- Core App ----------------------------------------------------------------
B2B_API_KEY=change-me
B2B_JWT_SECRET=
B2B_ENV=dev
B2B_DB_PATH=./b2b_ai.db
B2B_HOST=0.0.0.0
B2B_PORT=8000

# LLM provider (openai | anthropic | deepseek | openrouter | "" = rules-only)
B2B_LLM_PROVIDER=
#B2B_LLM_MODEL=gpt-4o-mini

# --- Email / SMTP (alternative to SendGrid) ----------------------------------
#B2B_SMTP_HOST=smtp.tu-proveedor.com
#B2B_SMTP_PORT=465
#B2B_SMTP_USER=agente@tu-dominio.com
#B2B_SMTP_PASSWORD=********
#B2B_SMTP_FROM=agente@tu-dominio.com
#B2B_SMTP_USE_SSL=true

# === LIKIDA AI — Modelos USA para producción ===
# Default: clasificación, respuestas simples
LIKIDA_DEFAULT_MODEL=gemini-flash

# Complejo: análisis fiscal, devolución IVA, pre-auditoría
LIKIDA_COMPLEX_MODEL=claude-sonnet

# Ligero: email processing, extracción CFDI
LIKIDA_LIGHT_MODEL=gpt-4o-mini
