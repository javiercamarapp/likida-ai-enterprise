# =============================================================================
# .env.example — Likida AI Enterprise (producción)
# Copia este archivo a .env.production y rellena los valores reales.
#   cp .env.example .env.production && vi .env.production
# NUNCA subas secretos reales al repositorio (.env.production está en .gitignore).
# Genera secretos con:  openssl rand -hex 32
# =============================================================================

# --- Entorno ---
B2B_ENV=production              # development | production | test
B2B_DEFAULT_EMAIL=admin@likida.ai

# --- Base de datos (PostgreSQL) ---
# Docker Compose local/VPS:
POSTGRES_DB=b2b_ai
POSTGRES_USER=b2b
POSTGRES_PASSWORD=cambia-este-password
# Railway inyecta DATABASE_URL automáticamente con el plugin PostgreSQL — no la pongas aquí.
# DATABASE_URL=postgresql://b2b:***@postgres:5432/b2b_ai
# Configuración opcional del pool PG:
# B2B_PG_POOL_MIN=2
# B2B_PG_POOL_MAX=10
# B2B_PG_RETRIES=3

# --- Seguridad (GENERA con: openssl rand -hex 32) ---
# Obligatorias en producción: sin ellas la app falla al arrancar (fail-fast).
B2B_JWT_SECRET=
B2B_API_KEY=
B2B_ENCRYPTION_KEY=

# --- Server ---
B2B_HOST=0.0.0.0
B2B_PORT=8000
B2B_WORKERS=2
B2B_TRUST_PROXY=true           # detrás de Nginx/Railway
B2B_RATE_LIMIT=on
B2B_RATE_LIMIT_PER_MIN=300
B2B_RETENTION_DAYS=365
B2B_LOG_LEVEL=INFO

# --- CORS (vacío = solo same-origin; lista separada por comas) ---
# B2B_CORS_ORIGINS=https://app.likida.ai,https://www.likida.ai
# B2B_CORS_ALLOW_CREDENTIALS=false

# --- Redis (OPCIONAL — rate limiter usa memoria si no hay URL) ---
# B2B_REDIS_URL=redis://redis:6379/0

# --- Computer Use / ERP (Desktop) ---
# disabled | mock | playwright   (disabled es el modo seguro por defecto)
B2B_COMPUTER_USE_MODE=disabled
B2B_COMPUTER_USE_PROVIDER=contpaqi

# Credenciales del ERP (solo si COMPUTER_USE_MODE=playwright)
CONTPAQI_URL=
CONTPAQI_USERNAME=
CONTPAQI_PASSWORD=
ASPEL_URL=
ASPEL_USERNAME=
ASPEL_PASSWORD=

# --- Integraciones externas ---
# SAT / Facturapi / SPEI / Finkok
SAT_TIMEOUT=10
FINKOK_API_URL=
FINKOK_USERNAME=
FINKOK_PASSWORD=

# --- SMTP (notificaciones) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
