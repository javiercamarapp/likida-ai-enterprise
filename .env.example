# =============================================================================
# .env.example — Likida AI Enterprise
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env con secretos reales al repositorio.
# =============================================================================

# --- Entorno ---
B2B_ENV=development            # development | production | test
B2B_DEFAULT_EMAIL=

# --- Seguridad (GENERA con: openssl rand -hex 32) ---
B2B_JWT_SECRET=
B2B_API_KEY=
B2B_ENCRYPTION_KEY=

# --- Base de datos ---
# SQLite (dev):  B2B_DB_PATH=/data/b2b_ai.db
# PostgreSQL:    DATABASE_URL=postgresql://user:pass@host:5432/dbname
B2B_DB_PATH=/data/b2b_ai.db

# --- Server ---
B2B_HOST=0.0.0.0
B2B_PORT=8000
B2B_WORKERS=1

# --- Computer Use / ERP (Desktop) ---
# disabled | mock | playwright   (disabled es el modo seguro por defecto)
B2B_COMPUTER_USE_MODE=disabled
B2B_COMPUTER_USE_PROVIDER=contpaqi

# Credenciales del ERP (solo si COMPUTER_USE_MODE=playwright)
CONTPAQI_URL=
CONTPAQI_USERNAME=
CONTPAQI_PASSWORD=
ASPEL_URL=
ASPEL_USERNAME=
ASPEL_PASSWORD=

# --- Integraciones externas ---
# SAT / Facturapi / SPEI / Finkok
SAT_TIMEOUT=10
FINKOK_API_URL=
FINKOK_USERNAME=
FINKOK_PASSWORD=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- Limitadores / Costo ---
RATE_LIMIT_PER_MINUTE=60
