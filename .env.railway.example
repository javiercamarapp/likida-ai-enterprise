# =============================================================================
# .env.railway.example — Variables para el plugin/panel de Railway.
# La mayoría las fija el one-click:  ./scripts/deploy-railway.sh
# Railway inyecta DATABASE_URL (PostgreSQL) y PORT automáticamente.
# =============================================================================
B2B_ENV=production
B2B_WORKERS=1
B2B_TRUST_PROXY=true
B2B_RATE_LIMIT=on
B2B_RATE_LIMIT_PER_MIN=300

# Secretos — genera y fija en Railway → Variables:
# B2B_JWT_SECRET       (openssl rand -hex 32)
# B2B_ENCRYPTION_KEY   (openssl rand -hex 24)
# B2B_API_KEY          (openssl rand -hex 32)
