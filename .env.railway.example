# =============================================================================
# .env.railway.example — Variables de entorno para Railway (producción)
# =============================================================================
# Copia este archivo y ajústalo ANTES de desplegar a Railway.
# Railway reemplaza DATABASE_URL y REDIS_URL automáticamente al crear los
# add-ons de PostgreSQL y Redis desde el dashboard.
#
# Para Railway CLI:
#   railway variables set B2B_JWT_SECRET="..." --environment production
#   railway variables set B2B_API_KEY="..."     --environment production
#
# Genera secretos con:
#   openssl rand -hex 32
# =============================================================================

# --- Base de datos (auto-configurado por Railway) ---------------------------
# Railway asigna DATABASE_URL automáticamente al agregar el add-on PostgreSQL.
# La app lo lee como B2B_DB_URL internamente. NO lo configures manualmente.
# DATABASE_URL=postgresql://user:pass@host:5432/bb_ai

# Pool de conexiones PostgreSQL (opcional, defaults sanos)
B2B_PG_POOL_MIN=2
B2B_PG_POOL_MAX=10
B2B_PG_RETRIES=3

# --- Redis (auto-configurado por Railway) -----------------------------------
# Railway asigna REDIS_URL automáticamente al agregar el add-on Redis.
# REDIS_URL=redis://:pass@host:6379/0

# --- Seguridad / Auth -------------------------------------------------------
# API key maestra de servicio. OBLIGATORIA.
# Genera con: openssl rand -hex 32
B2B_API_KEY=change-me-in-production

# Secret de firma de JWT (auth enterprise /api/v1/auth/*, RBAC por tenant).
# OBLIGATORIO en producción.
B2B_JWT_SECRET=change-me-in-production

# Clave de cifrado AES-GCM para campos sensibles en reposo.
# OBLIGATORIA en producción.
B2B_ENCRYPTION_KEY=change-me-in-production

# --- Entorno -----------------------------------------------------------------
B2B_ENVIRONMENT=production
B2B_DEBUG=false

# --- Workers -----------------------------------------------------------------
# Railway Pro: 0.5–1 CPU, 512MB–1GB RAM. 1 worker es seguro; subir solo
# con PostgreSQL (no SQLite).
B2B_WORKERS=1

# --- CORS (orígenes permitidos para la API) ---------------------------------
B2B_CORS_ORIGINS=https://bb-ai.com,https://www.bb-ai.com,https://app.bb-ai.com
B2B_CORS_ALLOW_CREDENTIALS=true

# --- Rate limiting -----------------------------------------------------------
B2B_RATE_LIMIT=on
B2B_RATE_LIMIT_PER_MIN=300

# --- Seguridad de transporte -------------------------------------------------
B2B_HSTS=true
B2B_HSTS_ALWAYS=true
B2B_TRUST_PROXY=true

# --- Billing / Pagos ---------------------------------------------------------
# Stripe (international)
B2B_STRIPE_KEY=sk_live_...
B2B_STRIPE_PUBLISHABLE_KEY=pk_live_...
B2B_STRIPE_WEBHOOK_SECRET=whsec_...

# Conekta (México)
B2B_CONEKTA_KEY=key_...
B2B_CONEKTA_PUBLIC_KEY=pk_live_...

# --- Notificaciones (email / SMTP) ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@bb-ai.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=B&B AI <notifications@bb-ai.com>
SMTP_USE_SSL=true

# --- WhatsApp Business API ---------------------------------------------------
WHATSAPP_TOKEN=your-whatsapp-business-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# --- LLM (opcional; pipeline corre 100% con reglas sin LLM) -----------------
B2B_LLM_PROVIDER=openai
B2B_LLM_MODEL=gpt-4o-mini
B2B_OPENAI_API_KEY=sk-...
# B2B_ANTHROPIC_API_KEY=sk-ant-...
# B2B_OPENROUTER_API_KEY=sk-or-...

# --- App URLs ----------------------------------------------------------------
B2B_APP_NAME=B&B AI
B2B_APP_URL=https://api.bb-ai.com
B2B_LANDING_URL=https://bb-ai.com
B2B_PORTAL_URL=https://app.bb-ai.com

# --- Datos -------------------------------------------------------------------
B2B_RETENTION_DAYS=365

# --- Monitoreo / Alertas -----------------------------------------------------
# B2B_ALERT_WEBHOOK_URL=https://hooks.example.com/b2b-alerts
B2B_LOG_LEVEL=INFO
